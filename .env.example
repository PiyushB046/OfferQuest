# Leave GEMINI_API_KEY empty to run on the offline brain (no network needed).
GEMINI_API_KEY=
# The free tier allows only ~20 requests a day on gemini-2.5-flash (a quest uses about 8).
# gemini-flash-lite-latest has a larger free allowance.
GEMINI_MODEL=gemini-2.5-flash
# Free tier is tight: seconds to wait between Gemini calls.
GEMINI_MIN_INTERVAL=4.5
# Optional: raises the GitHub API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
