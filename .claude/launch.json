{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": [
        "backend.main:app",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "backend-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "GEMINI_API_KEY=",
        "OFFERQUEST_DATA=data-offline",
        ".venv/bin/uvicorn",
        "backend.main:app",
        "--port",
        "8001"
      ],
      "port": 8001
    },
    {
      "name": "frontend-offline",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_BACKEND=http://localhost:8001",
        "npm",
        "--prefix",
        "frontend",
        "run",
        "dev",
        "--",
        "--port",
        "5174",
        "--strictPort"
      ],
      "port": 5174
    }
  ]
}